    function toast(msg, type = 'info') {
        const colors = { info: 'bg-accent text-bg', success: 'bg-income text-bg', error: 'bg-expense text-white' };
        const icons = { info: 'fa-info', success: 'fa-check', error: 'fa-exclamation' };
        const el = document.createElement('div');
        el.className = `toast pointer-events-auto ${colors[type]} px-4 py-2.5 rounded-lg text-sm font-medium shadow-lg flex items-center gap-2`;
        el.innerHTML = `<i class="fa-solid ${icons[type]}"></i> ${msg}`;
        document.getElementById('toast-container').appendChild(el);
        setTimeout(() => { el.classList.add('removing'); setTimeout(() => el.remove(), 300); }, 3000);
    }

    // ==================== CAPA DE DATOS ====================
    function localLoad() { try { return JSON.parse(localStorage.getItem('hf_transactions') || '[]'); } catch { return []; } }
    function localSave(data) { localStorage.setItem('hf_transactions', JSON.stringify(data)); }

    async function loadTransactions() {
        if (state.sbClient) {
            try {
                const { data, error } = await state.sbClient.from('transactions').select('*').order('date', { ascending: false });
                if (error) throw error;
                state.transactions = data || [];
                state.isOnline = true;
                updateSyncStatus();
                return;
            } catch (e) {
                console.error('Supabase load error:', e);
                state.isOnline = false;
                updateSyncStatus();
            }
        }
        state.transactions = localLoad();
    }

    async function saveTransaction(t) {
        if (state.sbClient) {
            try {
                const { data, error } = await state.sbClient.from('transactions').insert(t).select();
                if (error) throw error;
                state.isOnline = true;
                updateSyncStatus();
                return data[0];
            } catch (e) {
                console.error('Supabase save error:', e);
                state.isOnline = false;
                updateSyncStatus();
                toast('Error Supabase, guardando local', 'error');
            }
        }
        const local = localLoad();
        t.id = crypto.randomUUID();
        t.created_at = new Date().toISOString();
        local.unshift(t);
        localSave(local);
        return t;
    }

    async function deleteTransaction(id) {
        if (state.sbClient) {
            try {
                const { error } = await state.sbClient.from('transactions').delete().eq('id', id);
                if (error) throw error;
                state.isOnline = true; updateSyncStatus(); return;
            } catch (e) { state.isOnline = false; updateSyncStatus(); }
        }
        localSave(localLoad().filter(t => t.id !== id));
    }

    // ==================== REALTIME ====================
    function subscribeRealtime() {
        if (!state.sbClient) return;
        try {
            state.sbClient.channel('hf-changes')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'transactions' }, async () => {
                    await loadTransactions();
                    renderCurrentView();
                })
                .subscribe();
        } catch (e) { console.error('Realtime error:', e); }
    }

    function updateSyncStatus() {
        const el = document.getElementById('sync-status');
        if (!el) return;
        if (state.sbClient) {
            el.innerHTML = state.isOnline
                ? '<span class="w-2 h-2 rounded-full bg-income animate-pulse"></span> Sincronizado con Supabase'
                : '<span class="w-2 h-2 rounded-full bg-expense"></span> Desconectado';
        } else {
            el.innerHTML = '<span class="w-2 h-2 rounded-full bg-accent"></span> Datos locales';
        }
    }


    function renderRecentTransactions() {
        const el = document.getElementById('recent-transactions');
        const recent = state.transactions.slice(0, 8);
        if (!recent.length) { el.innerHTML = '<p class="text-muted text-sm text-center py-6">Sin movimientos aún</p>'; return; }
        el.innerHTML = recent.map(t => {
            const cat = getCat(t.category); const isInc = t.type === 'income';
            return `<div class="flex items-center gap-3 py-2 px-2 rounded-lg hover:bg-bg/50 transition">
                <div class="w-8 h-8 rounded-lg flex items-center justify-center text-xs" style="background:${cat.color}20; color:${cat.color}"><i class="fa-solid ${cat.icon}"></i></div>
                <div class="flex-1 min-w-0"><p class="text-sm truncate">${t.description || cat.name}</p><p class="text-xs text-muted">${fmtDate(t.date)} · ${t.user_name}</p></div>
                <span class="text-sm font-medium ${isInc ? 'text-income' : 'text-expense'}">${isInc ? '+' : '-'}${fmt(Number(t.amount))}</span>
            </div>`;
        }).join('');

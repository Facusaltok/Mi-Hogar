    // ==================== UTILIDADES ====================
    function fmt(n) {
        const sym = CURRENCY_MAP[state.currency] || '$';
        const abs = Math.abs(n);
        const formatted = abs >= 1000 ? abs.toLocaleString('es', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) : abs.toFixed(abs % 1 === 0 ? 0 : 2);
        return (n < 0 ? '-' : '') + sym + formatted;

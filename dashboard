    // ==================== DASHBOARD ====================
    let chartTrend = null, chartCats = null;

    function renderDashboard() {
        const range = currentMonthRange();
        document.getElementById('month-label').textContent = monthName(state.monthOffset);
        const mn = monthName(state.monthOffset);
        document.getElementById('dash-subtitle').textContent = mn.charAt(0).toUpperCase() + mn.slice(1);

        const monthTx = state.transactions.filter(t => t.date >= range.start && t.date <= range.end);
        const income = monthTx.filter(t => t.type === 'income').reduce((s, t) => s + Number(t.amount), 0);
        const expense = monthTx.filter(t => t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0);
        const balance = income - expense;
        const savings = income - expense;
        const savingsPct = income > 0 ? Math.round((savings / income) * 100) : 0;

        document.getElementById('stat-balance').textContent = fmt(balance);

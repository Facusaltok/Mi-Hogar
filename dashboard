    // ==================== ANALÍTICAS ====================
    let chartMonthly = null, chartDonut = null, chartUsers = null;

    function renderAnalytics() { renderMonthlyChart(); renderDonutChart(); renderUsersChart(); renderTopCategories(); }

    function renderMonthlyChart() {
        const ctx = document.getElementById('chart-monthly'); if (!ctx) return;
        const labels = [], incomeData = [], expenseData = [], savingsData = [];
        for (let i = -5; i <= 0; i++) {
            const d = new Date(); d.setMonth(d.getMonth() + i, 1);
            const start = new Date(d.getFullYear(), d.getMonth(), 1).toISOString().slice(0, 10);
            const end = new Date(d.getFullYear(), d.getMonth() + 1, 0).toISOString().slice(0, 10);
            labels.push(d.toLocaleDateString('es', { month: 'short', year: '2-digit' }));
            const mTx = state.transactions.filter(t => t.date >= start && t.date <= end);
            const inc = mTx.filter(t => t.type === 'income').reduce((s, t) => s + Number(t.amount), 0);
            const exp = mTx.filter(t => t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0);
            incomeData.push(inc); expenseData.push(exp); savingsData.push(inc - exp);
        }
        if (chartMonthly) chartMonthly.destroy();
        chartMonthly = new Chart(ctx, {
            type: 'line',
            data: { labels, datasets: [
                { label: 'Ingresos', data: incomeData, borderColor: '#00D68F', backgroundColor: 'rgba(0,214,143,0.1)', fill: true, tension: 0.4, pointRadius: 4 },
                { label: 'Gastos', data: expenseData, borderColor: '#FF6B6B', backgroundColor: 'rgba(255,107,107,0.1)', fill: true, tension: 0.4, pointRadius: 4 },
                { label: 'Ahorro', data: savingsData, borderColor: '#FFB800', backgroundColor: 'rgba(255,184,0,0.05)', fill: true, tension: 0.4, pointRadius: 4, borderDash: [5,5] }
            ]},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#888', font: { size: 11 }, boxWidth: 12, padding: 15 } } },
                scales: { x: { grid: { display: false }, ticks: { color: '#888', font: { size: 11 } } }, y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#888', font: { size: 11 }, callback: v => v >= 1000 ? (v/1000)+'k' : v } } } }
        });
    }

    function renderDonutChart() {
        const ctx = document.getElementById('chart-donut'); if (!ctx) return;
        const expenses = state.transactions.filter(t => t.type === 'expense');
        const byCat = {}; expenses.forEach(t => { byCat[t.category] = (byCat[t.category] || 0) + Number(t.amount); });
        const sorted = Object.entries(byCat).sort((a, b) => b[1] - a[1]);
        const total = sorted.reduce((s, [,v]) => s + v, 0);
        if (chartDonut) chartDonut.destroy();
        chartDonut = new Chart(ctx, {
            type: 'doughnut',
            data: { labels: sorted.map(([k]) => getCat(k).name), datasets: [{ data: sorted.map(([,v]) => v), backgroundColor: sorted.map(([k]) => getCat(k).color), borderWidth: 0, hoverOffset: 8 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'right', labels: { color: '#888', font: { size: 10 }, boxWidth: 10, padding: 8 } }, tooltip: { callbacks: { label: ctx => { const pct = total > 0 ? Math.round((ctx.raw/total)*100) : 0; return `${ctx.label}: ${fmt(ctx.raw)} (${pct}%)`; } } } } }
        });
    }

    function renderUsersChart() {
        const ctx = document.getElementById('chart-users'); if (!ctx) return;

    function renderCategoryChart(monthTx) {
        const ctx = document.getElementById('chart-categories'); if (!ctx) return;
        const expenses = monthTx.filter(t => t.type === 'expense');
        const byCat = {};
        expenses.forEach(t => { byCat[t.category] = (byCat[t.category] || 0) + Number(t.amount); });
        const sorted = Object.entries(byCat).sort((a, b) => b[1] - a[1]);
        if (chartCats) chartCats.destroy();
        chartCats = new Chart(ctx, {
            type: 'doughnut',
            data: { labels: sorted.map(([k]) => getCat(k).name), datasets: [{ data: sorted.map(([,v]) => v), backgroundColor: sorted.map(([k]) => getCat(k).color), borderWidth: 0, hoverOffset: 8 }] },
            options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'right', labels: { color: '#888', font: { size: 10 }, boxWidth: 10, padding: 8 } } } }
        });

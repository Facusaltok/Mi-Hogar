    function currentMonthRange() {
        const d = new Date(); d.setMonth(d.getMonth() + state.monthOffset, 1);
        const start = new Date(d.getFullYear(), d.getMonth(), 1);
        const end = new Date(d.getFullYear(), d.getMonth() + 1, 0);
        return { start: start.toISOString().slice(0, 10), end: end.toISOString().slice(0, 10), month: d.getMonth(), year: d.getFullYear() };
    }
    function getCat(id) { return CATEGORIES.find(c => c.id === id) || CATEGORIES[CATEGORIES.length - 1]; }

        const u1Inc = state.transactions.filter(t => t.user_name === u1 && t.type === 'income').reduce((s, t) => s + Number(t.amount), 0);
        const u2Inc = state.transactions.filter(t => t.user_name === u2 && t.type === 'income').reduce((s, t) => s + Number(t.amount), 0);
        const u1Exp = state.transactions.filter(t => t.user_name === u1 && t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0);
        const u2Exp = state.transactions.filter(t => t.user_name === u2 && t.type === 'expense').reduce((s, t) => s + Number(t.amount), 0);
        if (chartUsers) chartUsers.destroy();
        chartUsers = new Chart(ctx, {
            type: 'bar',
            data: { labels: ['Ingresos', 'Gastos', 'Ahorro'], datasets: [
                { label: u1, data: [u1Inc, u1Exp, u1Inc-u1Exp], backgroundColor: 'rgba(96,165,250,0.7)', borderRadius: 6 },
                { label: u2, data: [u2Inc, u2Exp, u2Inc-u2Exp], backgroundColor: 'rgba(244,114,182,0.7)', borderRadius: 6 }
            ]},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { color: '#888', font: { size: 11 }, boxWidth: 12 } } },
                scales: { x: { grid: { display: false }, ticks: { color: '#888' } }, y: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { color: '#888', callback: v => v >= 1000 ? (v/1000)+'k' : v } } } }
        });
    }

    function renderTopCategories() {
        const el = document.getElementById('top-categories');
        const expenses = state.transactions.filter(t => t.type === 'expense');
        const byCat = {}; expenses.forEach(t => { byCat[t.category] = (byCat[t.category] || 0) + Number(t.amount); });
        const sorted = Object.entries(byCat).sort((a, b) => b[1] - a[1]).slice(0, 6);
        const max = sorted[0]?.[1] || 1;
        el.innerHTML = sorted.map(([id, amount]) => {
            const cat = getCat(id); const pct = Math.round((amount / max) * 100);
            return `<div><div class="flex items-center justify-between mb-1"><span class="text-sm flex items-center gap-2"><i class="fa-solid ${cat.icon} text-xs" style="color:${cat.color}"></i> ${cat.name}</span><span class="text-sm font-medium">${fmt(amount)}</span></div><div class="h-2 bg-brd rounded-full overflow-hidden"><div class="h-full rounded-full transition-all duration-500" style="width:${pct}%; background:${cat.color}"></div></div></div>`;
        }).join('');
        if (!sorted.length) el.innerHTML = '<p class="text-muted text-sm text-center py-4">Sin datos</p>';
    }

    // ==================== AJUSTES ====================
    function renderSettings() {
        document.getElementById('settings-user1').value = state.users.user1;
        document.getElementById('settings-user2').value = state.users.user2;
        document.getElementById('settings-currency').value = state.currency;
        const sbEl = document.getElementById('settings-supabase');
        if (state.sbClient) {
            sbEl.innerHTML = `<p class="text-sm text-income flex items-center gap-2"><i class="fa-solid fa-circle-check"></i> Conectado a Supabase</p><p class="text-xs text-muted mt-1">${SB_URL}</p>`;
        } else {
            sbEl.innerHTML = `<p class="text-sm text-expense flex items-center gap-2"><i class="fa-solid fa-circle-xmark"></i> Sin conexión</p><button onclick="retryConnect()" class="mt-2 text-xs text-accent hover:text-accenthover transition">Reintentar conexión</button>`;
        }
    }

    function saveUserNames() {
        state.users.user1 = document.getElementById('settings-user1').value || 'Él';
        state.users.user2 = document.getElementById('settings-user2').value || 'Ella';
        localStorage.setItem('hf_users', JSON.stringify(state.users));
        updateFilterOptions(); updateSidebarUsers(); renderCurrentView();
        toast('Nombres actualizados', 'success');
    }

    function saveCurrency() {
        state.currency = document.getElementById('settings-currency').value;
        localStorage.setItem('hf_currency', state.currency);
        renderCurrentView();
    }

    function exportData() {
        const blob = new Blob([JSON.stringify(state.transactions, null, 2)], { type: 'application/json' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `hogarfin-${today()}.json`; a.click();
        toast('Datos exportados', 'success');
    }

    function clearAllData() {
        const el = document.createElement('div');
        el.className = 'toast pointer-events-auto bg-expense/90 px-4 py-3 rounded-lg text-sm shadow-lg flex items-center gap-3 text-white';
        el.innerHTML = `<span>¿Borrar TODOS los datos?</span><button onclick="doClearAll(this)" class="bg-white text-expense text-xs px-3 py-1 rounded-lg font-bold transition">Sí</button><button onclick="this.closest('.toast').remove()" class="bg-white/20 text-xs px-3 py-1 rounded-lg font-medium transition">No</button>`;
        document.getElementById('toast-container').appendChild(el);
    }

    async function doClearAll(btn) {
        btn.closest('.toast').remove();
        if (state.sbClient) { try { await state.sbClient.from('transactions').delete().neq('id', '00000000-0000-0000-0000-000000000000'); } catch {} }
        localSave([]); state.transactions = []; renderCurrentView(); toast('Datos eliminados', 'success');
    }

    // ==================== MODAL AGREGAR ====================
    function openAddModal() {
        document.getElementById('modal-add').classList.remove('hidden');
        document.getElementById('modal-amount').value = '';
        document.getElementById('modal-desc').value = '';
        document.getElementById('modal-date').value = today();
        state.modalType = 'expense'; state.modalCategory = 'alimentacion'; state.modalUser = state.users.user1;
        updateModalType(); renderModalCategories(); renderModalUsers();
        setTimeout(() => document.getElementById('modal-amount').focus(), 100);
    }
    function closeAddModal() { document.getElementById('modal-add').classList.add('hidden'); }

    function setModalType(type) { state.modalType = type; state.modalCategory = type === 'income' ? 'trabajo' : 'alimentacion'; updateModalType(); renderModalCategories(); }

    function updateModalType() {
        const expBtn = document.getElementById('btn-type-expense'), incBtn = document.getElementById('btn-type-income');
        if (state.modalType === 'expense') {
            expBtn.className = 'flex-1 py-2.5 rounded-lg text-sm font-semibold transition bg-expense/10 text-expense border-2 border-expense';
            incBtn.className = 'flex-1 py-2.5 rounded-lg text-sm font-semibold transition bg-card text-muted border-2 border-transparent';
        } else {
            incBtn.className = 'flex-1 py-2.5 rounded-lg text-sm font-semibold transition bg-income/10 text-income border-2 border-income';
            expBtn.className = 'flex-1 py-2.5 rounded-lg text-sm font-semibold transition bg-card text-muted border-2 border-transparent';
        }
    }

    function renderModalCategories() {
        const cats = state.modalType === 'income' ? CATEGORIES.filter(c => ['trabajo','freelance','regalos','otros'].includes(c.id)) : CATEGORIES.filter(c => !['trabajo','freelance'].includes(c.id));
        document.getElementById('modal-categories').innerHTML = cats.map(c => `<button onclick="selectCategory('${c.id}')" class="cat-btn flex flex-col items-center gap-1 p-2 rounded-lg border-2 transition ${state.modalCategory === c.id ? 'border-accent bg-accent/5' : 'border-transparent bg-card hover:bg-cardhover'}"><i class="fa-solid ${c.icon} text-sm" style="color:${c.color}"></i><span class="text-[10px] ${state.modalCategory === c.id ? 'text-white' : 'text-muted'}">${c.name}</span></button>`).join('');
    }
    function selectCategory(id) { state.modalCategory = id; renderModalCategories(); }

    function renderModalUsers() {
        document.getElementById('modal-users').innerHTML = [state.users.user1, state.users.user2].map((name, i) => `<button onclick="selectUser('${name}')" class="cat-btn flex items-center justify-center gap-2 py-2.5 rounded-lg border-2 transition ${state.modalUser === name ? 'border-accent bg-accent/5' : 'border-transparent bg-card hover:bg-cardhover'}"><i class="fa-solid ${i === 0 ? 'fa-mars' : 'fa-venus'} ${i === 0 ? 'text-blue-400' : 'text-pink-400'} text-sm"></i><span class="text-sm ${state.modalUser === name ? 'text-white font-medium' : 'text-muted'}">${name}</span></button>`).join('');
    }
    function selectUser(name) { state.modalUser = name; renderModalUsers(); }

    async function addTransaction() {
        const amount = parseFloat(document.getElementById('modal-amount').value);
        if (!amount || amount <= 0) { toast('Ingresa un monto válido', 'error'); return; }
        const t = { user_name: state.modalUser, type: state.modalType, category: state.modalCategory, amount, description: document.getElementById('modal-desc').value.trim(), date: document.getElementById('modal-date').value || today() };
        await saveTransaction(t);
        await loadTransactions();
        closeAddModal();
        renderCurrentView();
        toast(`${t.type === 'income' ? 'Ingreso' : 'Gasto'} registrado: ${getCat(t.category).name}`, 'success');
    }

    // ==================== SETUP ====================
    function copySQL() {
        const sql = document.getElementById('sql-code').textContent;
        navigator.clipboard.writeText(sql).then(() => toast('SQL copiado al portapapeles', 'success'));
    }

    async function connectAndStart() {
        const u1 = document.getElementById('setup-user1').value.trim() || 'Él';
        const u2 = document.getElementById('setup-user2').value.trim() || 'Ella';
        state.users.user1 = u1; state.users.user2 = u2;
        localStorage.setItem('hf_users', JSON.stringify(state.users));

        try {
            state.sbClient = supabase.createClient(SB_URL, SB_KEY);
            const { error } = await state.sbClient.from('transactions').select('id').limit(1);
            if (error) throw error;
            state.isOnline = true;
            subscribeRealtime();
            toast('Conectado a Supabase', 'success');
        } catch (e) {
            console.error('Error conexión Supabase:', e);
            state.sbClient = null;
            state.isOnline = false;
            toast('No se pudo conectar. ¿Creaste la tabla? Usando datos locales.', 'error');
        }

        localStorage.setItem('hf_setup_done', '1');
        document.getElementById('setup-overlay').style.display = 'none';
        document.getElementById('app').classList.remove('hidden');
        updateSidebarUsers(); updateFilterOptions(); updateSyncStatus();
        await loadTransactions();
        renderDashboard();
    }

    async function retryConnect() {
        try {
            state.sbClient = supabase.createClient(SB_URL, SB_KEY);
            const { error } = await state.sbClient.from('transactions').select('id').limit(1);
            if (error) throw error;
            state.isOnline = true;
            subscribeRealtime();
            toast('Conectado a Supabase', 'success');
            await loadTransactions();
            renderCurrentView();
        } catch (e) {
            toast('Aún sin conexión. Verifica que la tabla exista.', 'error');
        }
        updateSyncStatus(); renderSettings();
    }

    function updateSidebarUsers() {
        document.getElementById('sidebar-users').innerHTML = `<div class="flex -space-x-2"><div class="w-8 h-8 rounded-full bg-blue-500/20 border-2 border-surface flex items-center justify-center"><i class="fa-solid fa-mars text-blue-400 text-xs"></i></div><div class="w-8 h-8 rounded-full bg-pink-500/20 border-2 border-surface flex items-center justify-center"><i class="fa-solid fa-venus text-pink-400 text-xs"></i></div></div><span class="text-xs text-muted">${state.users.user1} & ${state.users.user2}</span>`;
    }

    function updateFilterOptions() {
        document.getElementById('filter-user').innerHTML = `<option value="all">Ambos</option><option value="${state.users.user1}">${state.users.user1}</option><option value="${state.users.user2}">${state.users.user2}</option>`;
        document.getElementById('filter-category').innerHTML = `<option value="all">Categorías</option>` + CATEGORIES.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
    }

    // ==================== INIT ====================
    (function init() {
        const users = localStorage.getItem('hf_users');
        const currency = localStorage.getItem('hf_currency');
        if (users) try { state.users = JSON.parse(users); } catch {}
        if (currency) state.currency = currency;

        if (localStorage.getItem('hf_setup_done')) {
            // Auto-conectar si ya se configuró antes
            (async () => {
                try {
                    state.sbClient = supabase.createClient(SB_URL, SB_KEY);
                    const { error } = await state.sbClient.from('transactions').select('id').limit(1);
                    if (error) throw error;
                    state.isOnline = true;
                    subscribeRealtime();
                } catch { state.sbClient = null; state.isOnline = false; }
                document.getElementById('setup-overlay').style.display = 'none';
                document.getElementById('app').classList.remove('hidden');
                updateSidebarUsers(); updateFilterOptions(); updateSyncStatus();
                await loadTransactions();
                renderDashboard();
            })();
        }

        // Pre-poblar campos del setup
        document.getElementById('setup-user1').value = state.users.user1;
        document.getElementById('setup-user2').value = state.users.user2;
    })();

    // Sidebar click outside
    document.addEventListener('click', e => {
        const sb = document.getElementById('sidebar');
        if (sb.classList.contains('open') && !sb.contains(e.target) && !e.target.closest('[onclick*="toggleSidebar"]')) closeSidebar();
    });

    // Atajos
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeAddModal();
        if (e.key === 'n' && !e.ctrlKey && !e.metaKey && !e.target.closest('input,textarea,select') && document.getElementById('modal-add').classList.contains('hidden') && document.getElementById('setup-overlay').style.display === 'none') openAddModal();
    });
    </script>
</body>
</html>
